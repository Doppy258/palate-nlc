NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required: service role key for auto-confirming users on signup (Settings → API keys → Service Role secret)
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_...

# Optional: secret key for server-side writes (Supabase → Settings → API keys → secret)
# SUPABASE_SECRET_KEY=sb_secret_...

# Required for restaurant data: get a free API key at https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key

# Optional: direct Postgres URL to run migrations locally (Settings → Database → URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
